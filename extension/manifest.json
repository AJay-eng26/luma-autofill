{
  "manifest_version": 3,
  "name": "Luma Autofill",
  "version": "1.1.1",
  "description": "Fill Luma event registration forms from your profile; AI drafts open questions for you to review. You always click submit yourself.",
  "permissions": ["storage"],
  "host_permissions": ["https://luma.com/*", "https://lu.ma/*", "https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://luma.com/*", "https://lu.ma/*", "https://www.luma.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Luma Autofill settings" }
}
